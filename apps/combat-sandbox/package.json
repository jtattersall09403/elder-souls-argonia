{
  "name": "@elder-souls/combat-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node ../../packages/character-assets/verify.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false",
    "visual:install": "playwright install chromium",
    "visual:check": "npm run build && node scripts/capture-visual-scenarios.mjs --prebuilt --tiny --no-video",
    "visual:record": "npm run build && node scripts/capture-visual-scenarios.mjs --prebuilt"
  },
  "dependencies": {
    "@elder-souls/character": "^0.1.0",
    "@elder-souls/game-core": "^0.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "ecctrl": "^2.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}
