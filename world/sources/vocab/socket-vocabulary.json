  "fishing-gear": {"assetSource": "vanilla:meshes/clutter/common (fishingpole, fishingpolecollection01)", "valueBand": "low"},
  "pelt": {"assetSource": "vanilla:meshes/clutter/pelts", "valueBand": "low"},
  "ingredient": {"assetSource": "vanilla:meshes/clutter/ingredients", "valueBand": "low"},
  "potion": {"assetSource": "vanilla:meshes/clutter/potions", "valueBand": "moderate"},
  "coin": {"assetSource": "vanilla:meshes/clutter/coin01.nif", "valueBand": "low"},
  "gem": {"assetSource": "vanilla:meshes/clutter/gemstones", "valueBand": "precious"},
  "book": {"assetSource": "vanilla:meshes/clutter/books (basicbook, journal)", "valueBand": "low", "textBearing": true},
