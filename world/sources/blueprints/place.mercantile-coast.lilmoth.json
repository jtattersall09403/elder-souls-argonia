   "candidates": [
    {
     "id": "candidate.lilmoth.east-face",
     "positionM": [
      3660.0,
      6372.0
     ],
     "chosen": true,
     "why": "The east face of the promontory. Section from the crest out: 21.9 m at 3640/6350, a 22.5° bluff, a 7.4 m bench at 3720/6350 (slope 2.5°), a tidal flat at 1.3–1.5 m from 3800 to 3860 (flood band 1–3, wet-season inundated), then 1.0 m of water at 3880, 3.8 m at 3920 and a 6.6 m roadstead plateau from 3960 to 4040. That is four buildable tiers and a drowned quarter in one 400 m run, and the shallow shelf is 120 m wide — the canon reason large hulls anchor out and lighter in. 55 m from the approved anchor, well inside its 0.04 UV (296 m) tolerance."
    },
    {
     "id": "candidate.lilmoth.se-embayment",
     "positionM": [
      3700.0,
      6470.0
     ],
     "rejectedBecause": "The south-east embayment reaches 3.8 m of water 50 m off the shore and 15.5 m at 150 m. Deep water that close means a hull could berth alongside, which contradicts the canon fact the city is built over shallow water and lighters its cargo (Lore:Lilmoth). It also has no bench between the shore and the crest, so the city would be one tier, not three.",
     "why": "Shore at roughly 3790/6540, water 0.6 m at 3798/6548, 3.8 m at 3826/6576, 9.6 m at 3855/6605, 25.5 m at 3939/6689; the SE ray falls 18.6 m to the waterline over 280 m with no flat step."
    },
    {
     "id": "candidate.lilmoth.south-lagoon",
     "positionM": [
      3604.0,
      6520.0
     ],
     "rejectedBecause": "The southern lagoon behind the spit is 0.4–0.6 m deep at 3600/6590–6630 and land again at 3600/6670. Nothing there can be drowned to dive depth, so the drowned quarter — the record's signature — would be a puddle, and no lighter could reach open water.",
     "why": "Sheltered water and a natural breakwater, which is why it was measured at all: 2.0 m of land at 3600/6510, 1.05 m at 3600/6550, 0.4 m of water at 3600/6590, land at 1.6 m again at 3600/6670."
    }
   ]
