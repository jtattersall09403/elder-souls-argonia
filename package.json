{
  "name": "elder-souls-argonia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/repo-standards"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run weapons:reach -- --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @elder-souls/combat-sandbox",
    "weapons:reach": "node tooling/asset-pipeline/scripts/bake-weapon-reach.mjs"
  },
  "devDependencies": {
    "rolldown": "1.2.5"
  }
}
