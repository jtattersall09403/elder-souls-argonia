# --- Proprietary Bethesda source & generated assets (NEVER commit) ---
# Trailing-slash forms match a real directory but not a symlink, and the owned
# Skyrim data is usually linked in from wherever it was downloaded rather than
# copied. Match both.
skyrim-source/Data
skyrim-source/Data/
skyrim-source/extracted
skyrim-source/extracted/
skyrim-source/mod-sources
skyrim-source/mod-sources/
skyrim-source/.DepotDownloader/
build/
output/*.glb
output/*.blend
output/*.png
output/*.gif
output/*.svg
output/**/

# Keep the runtime animation manifest (metadata only, no Bethesda bytes)
!output/
!output/*.animations.json
output/audition-*.animations.json

# --- Python ---
__pycache__/
*.pyc
.venv/
shots/

# --- Black Marsh & Valenwood mod source (huge, never commit; see module 90) ---
black-marsh-mod-source/
