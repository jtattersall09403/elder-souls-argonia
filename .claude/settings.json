{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/repo-standards/session_tokens.py --brief --last 10 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[0079] planner: look-ups -> find agent, jobs -> run agent, no shell exploration, no sleep.'"
          },
          {
            "type": "command",
            "command": "python3 tooling/repo-standards/session_switch.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/repo-standards/prose_hook.py",
            "timeout": 40
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/repo-standards/shell_guard.py"
          },
          {
            "type": "command",
            "command": "python3 tooling/repo-standards/review_gate.py",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
